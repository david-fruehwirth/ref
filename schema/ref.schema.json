{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ref-cli/ref/schema/ref.schema.json",
  "title": "ref reference metadata",
  "type": "object",
  "additionalProperties": false,
  "required": ["type", "title", "authors"],
  "properties": {
    "type": {"enum": ["article","book","mvbook","inbook","bookinbook","suppbook","booklet","collection","mvcollection","incollection","suppcollection","dataset","manual","misc","online","patent","periodical","suppperiodical","proceedings","mvproceedings","inproceedings","reference","mvreference","inreference","report","set","software","thesis","unpublished","xdata"]},
    "title": {"type": "string", "minLength": 1},
    "authors": {"type": "array", "items": {"oneOf": [
      {"type":"object","additionalProperties":false,"required":["given","family"],"properties":{"given":{"type":"string"},"family":{"type":"string","minLength":1}}},
      {"type":"object","additionalProperties":false,"required":["organization"],"properties":{"organization":{"type":"string","minLength":1}}}
    ]}},
    "year": {"type":"integer","minimum":1000,"maximum":3000},
    "date": {"type":["string","integer"], "pattern":"^[0-9]{4}(-[0-9]{2}(-[0-9]{2})?)?$"},
    "container_title": {"type":"string"}, "publisher": {"type":"string"},
    "volume": {"type":"string"}, "issue": {"type":"string"}, "pages": {"type":"string"},
    "doi": {"type":"string"}, "url": {"type":"string","format":"uri","pattern":"^https?://"},
    "urldate": {"type":"string","format":"date","pattern":"^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
    "tags": {"type":"array","items":{"type":"string"}}, "notes": {"type":"string"},
    "added_at": {"type":"string"}, "pdf_filename": {"type":"string","minLength":1},
    "pdf_sha256": {"type":"string","pattern":"^[0-9a-f]{64}$"}
  }
}
